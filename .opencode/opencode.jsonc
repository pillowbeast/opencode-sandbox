{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "watcher": {
    "ignore": ["**/.env*"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "permission": {
    "read": {
      "~/.config/opencode/get-shit-done/*": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*id_rsa*": "deny",
      "**/.ssh/*": "deny",
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "npm *": "allow",
      "node*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "mkdir*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "find*": "allow",
      "head*": "allow",
      "echo*": "allow",
      "basename*": "allow",
      "wc*": "allow",
      "pnpm*": "allow",
      "curl*": "allow",
      "sleep*": "allow",
      "ss*": "allow",
      "lsof*": "allow",
      "sudo*": "deny",
      "docker*": "deny",
      "rm -rf*": "deny",
      "git push*": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "playwright_*": "allow",
    "external_directory": {
      "~/.config/opencode/get-shit-done/*": "allow"
    }
  }
}
